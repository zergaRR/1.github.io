# Скопируйте этот файл в .env и при необходимости измените значения.
# cp .env.example .env

# PostgreSQL. Значение по умолчанию совпадает с docker-compose.yml из репозитория.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Каталог для загруженных медиафайлов (видео и инфографика).
# По умолчанию: ./data/uploads
# UPLOAD_DIR=./data/uploads
